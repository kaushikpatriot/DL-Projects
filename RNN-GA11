= [],[],[],[],[],[],[],[]\n","    #Forward Prop\n","    #RNN1\n","    for i in range(len(X1)):\n","      if i==0:\n","        p.append(W_e@h0 + U_e@X1[i])\n","      else:\n","        p.append(W_e@h[i-1] + U_e@X1[i])\n","      h.append(tanh(p[i]))\n","\n","    #Set decoder input = encoder output\n","    s0 = h[-1]\n","\n","    #RNN2\n","    for j in range(len(X2)):\n","      if j==0:\n","        z.append(W_d@s0 + U_d@X2[j])\n","      else:\n","        if autoregress:\n","          z.append(W_d@s[j-1] + U_d@y_pred[j-1])\n","        else:\n","          z.append(W_d@s[j-1] + U_d@X2[j])\n","      s.append(tanh(z[j]))\n","      r.append(V_d@s[j])\n","      y.append(softmax(r[j]))\n","      y_temp = np.zeros_like(s0)\n","      y_temp[np.argmax(y[j])]=1\n","      y_pred.append(y_temp)\n","      temp_loss = -1*(Y[j]@np.log(y[j]))\n","      loss.append(temp_loss)\n","    total_losses.append(np.sum(loss))\n","    if (epoch == epochs-1):\n","      print(f'Total loss is {np.sum(loss)}')\n","      v=0\n","      for k in h:\n","        v+=1\n","        print(f'Sum of h{v} is {np.sum(k)}')\n","      print(f'Sum of s5 is {np.sum(s[-1])}')\n","      print('The word predicted is :', end=' ')\n","      for letter in y_pred:\n","        if (letter==l).all(): print ('l', end='')\n","        elif (letter==e).all(): print ('e', end='')\n","        elif (letter==a2).all(): print ('a', end='')\n","        elif (letter==r2).all(): print ('r', end='')\n","        elif (letter==n).all(): print ('n', end='')\n","      print(f'\\n')\n","      #print(total_losses)\n","\n","\n","\n","    #Back Prop\n","    dLdU_e, dLdU_d, dLdW_e, dLdW_d, dLdV_d = np.zeros_like(U_e), np.zeros_like(U_d), np.zeros_like(W_e), np.zeros_like(W_d), np.zeros_like(V_d)\n","    ds_nxt = np.zeros_like(s0)\n","    #RNN2\n","    for i in reversed(range(len(X2)-1)):\n","      dLdr = y[i] - Y[i]\n","      dLdV_d += np.outer(dLdr, s[i])\n","      dLds = V_d.T@dLdr + ds_nxt\n","      dLdz = dtanh(z[i])*dLds\n","      if (i-1) == -1:\n","        dLdW_d += np.outer(dLdz,s0)\n","      else:\n","        dLdW_d += np.outer(dLdz, s[i-1])\n","      ds_nxt = W_d.T@dLdz\n","\n","    #RNN1\n","    dh_nxt = ds_nxt.copy() #Carrying over the gradient accumulated upto s0\n","    for j in reversed(range(len(X1)-1)):\n","      dLdp = dtanh(p[j])*dh_nxt\n","      if j-1 == -1:\n","        dLdW_e += np.outer(dLdp, h0)\n","      else:\n","        dLdW_e += np.outer(dLdp, h[j-1])\n","      dLdU_e += np.outer(dLdp, X1[j])\n","      dh_nxt = W_e.T@dLdp\n","    #Update parameters\n","    eta = 1\n","    W_e -= eta*dLdW_e\n","    W_d -= eta*dLdW_d\n","    U_e -= eta*dLdU_e\n","    U_d -= eta*dLdU_d\n","    V_d -= eta*dLdV_d\n","  return total_losses\n","\n"],"metadata":{"id":"razGZWSpsEso","executionInfo":{"status":"ok","timestamp":1693239752931,"user_tz":-330,"elapsed":19,"user":{"displayName":"KAUSHIK V","userId":"17856010400179767796"}}},"execution_count":3,"outputs":[]},{"cell_type":"code","source":["total_losses = RNN(1000,True)\n","#total_losses"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qgJSbt69ulJy","executionInfo":{"status":"ok","timestamp":1693241294491,"user_tz":-330,"elapsed":1476,"user":{"displayName":"KAUSHIK V","userId":"17856010400179767796"}},"outputId":"a178d785-1868-4535-c9af-ab2e2775dec0"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["Total loss is 1.9107749393771292\n","Sum of h1 is 0.6053725104980913\n","Sum of h2 is -0.7386610451407183\n","Sum of h3 is 0.2280908866773863\n","Sum of h4 is 1.0674203010826293\n","Sum of h5 is 0.3989830294387333\n","Sum of s5 is -3.4355582713816246\n","The word predicted is : learl\n","\n"]}]},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","epochs = [i for i in range(20)]\n","plt.plot(epochs, total_losses)\n","plt.xticks(np.arange(0, 20, 10.0))\n","plt.yticks(np.arange(0, 20, 5.0))\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":430},"id":"p25AFJBOyqqX