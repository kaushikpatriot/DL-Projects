urve\n"],"metadata":{"id":"SWSZqYhaXG8W"}},{"cell_type":"markdown","source":["Gradient descent for Sigmoid\n"],"metadata":{"id":"atakZN5ZewFS"}},{"cell_type":"code","source":["def sigmoid(x,w,b):\n","  return 1/(1+np.exp(-(w*x+b)))\n","\n","X = np.array([-1,0.2])\n","Y = np.array([0.5,0.97])\n","\n","epochs, eta = 100, 1\n","w,b = -2,-2\n","loss_GD=[]\n","\n","for epoch in range(epochs):\n","  grad_w, grad_b = 0,0\n","  for x,y in zip(X,Y):\n","    y_hat = sigmoid(x,w,b)\n","    grad_w += (y_hat-y)*y_hat*(1-y_hat)*x\n","    grad_b += (y_hat-y)*y_hat*(1-y_hat)\n","  w -= eta*grad_w\n","  b -= eta*grad_b\n","  loss_GD.append(np.sum(Y-sigmoid(X,w,b)**2))\n","\n","plt.plot([i for i in range(epochs)],loss_GD)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":430},"id":"GvMtlUzGneek","executionInfo":{"status":"ok","timestamp":1687416445512,"user_tz":-330,"elapsed":471,"user":{"displayName":"KAUSHIK V","userId":"17856010400179767796"}},"outputId":"f1117fcd-7318-40c2-c306-b1e0de67ea44"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["Momentum based Gradient Descent"],"metadata":{"id":"wtroKjmGzkY7"}},{"cell_type":"code","source":["def sigmoid(x,w,b):\n","  return 1/(1+np.exp(-(w*x+b)))\n","\n","X = np.array([-1,0.2])\n","Y = np.array([0.5,0.97])\n","\n","epochs, eta, beta, nu = 100, 1, 0.9, 0\n","w,b = -2,-2\n","loss_GD=[]\n","\n","for epoch in range(epochs):\n","  grad_w, grad_b, uw, ub = 0,0,0,0\n","\n","  for x,y in zip(X,Y):\n","    y_hat = sigmoid(x,w,b)\n","    grad_w += (y_hat-y)*y_hat*(1-y_hat)*x\n","    grad_b += (y_hat-y)*y_hat*(1-y_hat)\n","  uw = beta*uw + eta*grad_w\n","  ub = beta*ub + eta*grad_b\n","  w -= uw\n","  b -= ub\n","  loss_GD.append(np.sum(Y-sigmoid(X,w,b)**2))\n","\n","plt.plot([i for i in range(epochs)],loss_GD)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://l