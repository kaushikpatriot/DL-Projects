{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOvPeQGZPVl5XfL690NZIH4"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["##Neural Network - Algorithm\n","###Forward Propagation\n","**x** = $[x_1, x_2.....x_n]^T$<br>\n","**y** = $[y_1, y_2.....y_n]^T$<br>\n","$W_i$ = $R^{n X m}$ <br>\n","$b_i$ = $R^{n X 1}$ <br>\n","$a_i = W_i.x + b_i$ <br>\n","$h_i = 1/(1+e^{(-a_i)}) where i != L$ <br>\n","$h_L = \\hat y = \\frac {e^{a_l}}{\\sum{e^{(a_i)}}}$ <br>\n","$Loss L(\\theta) = - y log \\hat y_l$\n","\n","###Back Propagation\n","$\\frac {\\partial {L(\\theta)}} {\\partial {\\hat y_i}} = \\frac {{\\partial (-log \\hat y_l)} }{ \\partial \\hat y_i} = \\frac {-1} {\\hat y_l} where i = l$ <br>\n","$= \\frac {-1_{i=l}}{\\hat y_l} e^l$\n","\n","$\\frac {\\partial L(\\theta)}{\\partial a_{31}} = \\frac {\\partial (-log \\hat y_l)}{\\partial a_{31}}$\n","  $= \\frac{\\partial({-log \\hat y_l})}{\\partial \\hat y}. \\frac {\\partial \\hat y}{ \\partial a_{31}} = \\frac {-1}{\\hat y_l}.\\frac {\\partial \\hat y}{ \\partial a_{31}}$\n","\n","$= \\frac {-1}{\\hat y_l} \\frac {\\partial ({\\frac {e^a_{31}}{e^a_{31}+e^a_{32}+e^a_{33}}})}{\\partial a_{31}}$\n","\n","...Incomplete...\n","\n","\n","\n","\n"],"metadata":{"id":"iCfiI-1FPdVM"}},{"cell_type":"markdown","source":["##Neural Network - Back Propagation\n","\n"],"metadata":{"id":"mQ3NjXINTHNo"}},{"cell_type":"code","execution_count":null,"metadata":{"id":"ZGpJAAIjtWnp"},"outputs":[],"source":["import numpy as np"]},{"cell_type":"code","source":["def sigmoid(z):\n","  return 1/(1+np.exp(-z))"],"metadata":{"id":"aL9KZGWgLW3j"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def softmax(Z):\n","  return np.exp(Z)/np.sum(np.exp(Z))"],"metadata":{"id":"H7RD8yyaLj_7"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#Initialise weights and input data\n","def init(no_layers):\n","  files = np.load('parameters.npz')\n","  x = np.array([1,0,1])\n","  y = np.array([0,0,1])\n","  W,B=[[]],[[]]\n","  for i in range(no_layers):\n","    num=i+1\n","    W.append(files.get('W'+str(num)))\n","    B.append(files.get('b'+str(num)))\n","  #print (W,B)\n","  return x,y,W,B\n"],"metadata":{"id":"oCEPFXuJJK1M"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#Neural Network\n","# Initialise inputs and weights\n","no_layers = 3\n","x,y,W,B = init(no_layers)\n","y_truelabel=np.argmax(y)\n","e_vector = np.zeros(y.shape)\n","e_vector[y_truelabel] = 1\n","\n","# Initialise epochs and learning rate\n","epochs, eta = 1, 1\n","\n","# Gradient Descent\n","for epoch in range(epochs):\n","  #Initialise matrices\n","  a,h=[x],[x]\n","  grad_w, grad_b=[],[]\n","  grad_a=[]\n","\n","  #Forward propagation\n","  #for hidden layers\n","  for layer in range(1, no_layers):\n","    #Add the pre-activation values for the neurons in the hidden layer\n","    a.append(W[layer]@h[layer-1]+B[layer].reshape(-1))\n","\n","    #Add the activation values for the neurons in the hidden layer\n","    h.append(sigmoid(a[layer]))\n","\n","  # for output layer\n","\n","  #Add the pre-activation values for the neurons in the output layer\n","  a.append(W[no_layers]@h[no_layers-1]+B[no_layers].reshape(-1,))\n","\n","  #Add the Activation/output values for the neurons in the output layer\n","  h.append(softmax(a[no_layers]))\n","  loss=-np.log(h[no_layers][y_truelabel])\n","  print('loss',loss)\n","\n","#Back propagation\n","  #for output layer\n","  grad_a.append(-(e_vector-h[no_layers]))\n","\n","  #for hidden layer\n","  for k in range(no_layers,0,-1):\n","     grad_w = [grad_a[0].reshape(-1,1)@h[k-1].reshape(-1,1).T] + grad_w\n","     grad_b = [grad_a[0]] + grad_b\n","     sigmoid_matrix = h[k-1]*(1-h[k-1])\n","     grad_a = [(W[k].T@grad_a[0])*sigmoid_matrix]+grad_a\n","\n","  # Adding empty lists for layer 0 to be consistent with the layer order\n","  #grad_a = [[]]+grad_a\n","  grad_w = [[]]+grad_w\n","  grad_b = [[]]+grad_b\n","\n","#Weight update\n","  for l in range(1,no_layers+1):\n","    W[l] = W[l] - eta*grad_w[l]\n","    B[l] = B[l] - eta*grad_b[l].reshape(-1,1)\n","\n","#Print parameters\n","for i in range(no_layers+1):\n","  print(f'Weight matrix for layer {i}: \\n {W[i]}')\n","  print(f'Bias vectors for layer {i}: \\n {B[i]}')\n","  print(f'Preactivation vector for layer {i}: \\n {a[i]}')\n","  print(f'Activation vector for layer {i}: \\n {h[i]}')\n","  print(f'Gradient of a for layer {i}: \\n {grad_a[i]}')\n","  print(f'Gradient of W for layer {i}: \\n {grad_w[i]}')\n","  print(f'Gradient of B for layer {i}: \\n {grad_b[i]}')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ep0L0mC8KcdR","executionInfo":{"status":"ok","timestamp":1688295636542,"user_tz":-330,"elapsed":416,"user":{"displayName":"KAUSHIK V","userId":"17856010400179767796"}},"outputId":"d3856f66-48c2-4e65-f45f-f66bbbf46d43"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["loss 0.8563785622753882\n","Weight matrix for layer 0: \n"," []\n","Bias vectors for layer 0: \n"," []\n","Preactivation vector for layer 0: \n"," [1 0 1]\n","Activation vector for layer 0: \n"," [1 0 1]\n","Gradient of a for layer 0: \n"," [ 0. -0. -0.]\n","Gradient of W for layer 0: \n"," []\n","Gradient of B for layer 0: \n"," []\n","Weight matrix for layer 1: \n"," [[0.54798032 0.71518937 0.60193019]\n"," [0.54347133 0.4236548  0.64448226]\n"," [0.4396994  0.891773   0.96577495]]\n","Bias vectors for layer 1: \n"," [[0.38260833]\n"," [0.79031318]\n"," [0.53100711]]\n","Preactivation vector for layer 1: \n"," [1.5350184  1.98250233 1.93014489]\n","Activation vector for layer 1: \n"," [0.82273938 0.87894766 0.87326546]\n","Gradient of a for layer 1: \n"," [ 0.00083319  0.00141185 -0.00211219]\n","Gradient of W for layer 1: \n"," [[ 0.00083319  0.          0.00083319]\n"," [ 0.00141185  0.          0.00141185]\n"," [-0.002