, x)\n","        a = self.activate(z)\n","        return a\n","\n","    def train(self, X, y):\n","        losses = []\n","        for _ in range(self.epochs):\n","            for i in range(y.shape[0]):\n","                x = np.insert(X[i], 0, 1)  # insert 1 for bias\n","                z = np.dot(self.weights, x)\n","                a = self.activate(z)\n","                error = y[i] - a\n","                self.weights += self.learning_rate * error * x\n","                losses.append(self.calculate_loss(X, y))\n","\n","        self.plot_loss_surface(X, y, losses)\n","\n","    def calculate_loss(self, X, y):\n","        loss = 0\n","        for i in range(y.shape[0]):\n","            x = np.insert(X[i], 0, 1)  # insert 1 for bias\n","            z = np.dot(self.weights, x)\n","            a = self.activate(z)\n","            error = y[i] - a\n","            loss += error ** 2\n","        return loss\n","\n","    def plot_loss_surface(self, X, y, losses):\n","        fig = plt.figure()\n","        ax = fig.add_subplot(111, projection='3d')\n","\n","        w0_range = np.linspace(-6, 6, 100)\n","        w1_range = np.linspace(-6, 6, 100)\n","        w0, w1 = np.meshgrid(w0_range, w1_range)\n","        loss_surface = np.zeros_like(w0)\n","\n","        for i in range(w0.shape[0]):\n","            for j in range(w0.shape[1]):\n","                self.weights[1] = w0[i, j]\n","                self.weights[2] = w1[i, j]\n","                loss_surface[i, j] = self.calculate_loss(X, y)\n","\n","        ax.plot_surface(w0, w1, loss_surface, cmap='viridis')\n","        ax.set_xlabel('Weight 1')\n","        ax.set_ylabel('Weight 2')\n","        ax.set_zlabel('Loss')\n","\n","        plt.show()\n","\n","# Example usage:\n","X = np.array([[0, 0], [0, 1], [1, 0], [1, 1]])\n","y = np.array([0, 0, 0, 1])\n","\n","perceptron = Perceptron(input_size=2)\n","perceptron.train(X, y)\n","\n","test_data = np.array([[0, 0], [0, 1], [1, 0], [1, 1]])\n","for i in range(test_data.shap